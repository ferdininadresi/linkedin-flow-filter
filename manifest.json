{
  "manifest_version": 3,
  "name": "LinkedIn Notification Flows",
  "version": "0.3.0",
  "description": "Split LinkedIn notifications into custom flows by person or organization. All data stays local (chrome.storage.local) — nothing is ever sent anywhere. Interface available in English and Turkish.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/notifications/*",
        "https://www.linkedin.com/notifications",
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Notification Flows",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}